# Modèle de infra/.env.prod (le vrai fichier est gitignoré et copié à la main par Sami, jamais par un agent).

# Adresse du site : un domaine, ou <ip>.sslip.io
SITE_ADDRESS=203.0.113.10.sslip.io

# Accès réservé (Caddy). Hash à produire avec : docker run --rm caddy:2 caddy hash-password --plaintext 'motdepasse'
BASIC_AUTH_USER=terranova
BASIC_AUTH_HASH=

# Base PostgreSQL (mot de passe long et aléatoire)
POSTGRES_PASSWORD=

# Jeton des endpoints coûteux (en-tête X-API-Token) et de l'envoi des archives (historique_x, timeline_ed)
API_TOKEN=

# Modèles (décision D1 : OpenRouter, clé propre au projet, plafond 30 $ / mois)
OPENROUTER_API_KEY=
LLM_MONTHLY_BUDGET_USD=30
LLM_DAILY_BUDGET_USD=2

# Origines autorisées (l'adresse du site)
CORS_ORIGINS=https://203.0.113.10.sslip.io
